rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Products: public can read, only authenticated admin can create/update/delete
    match /products/{productId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Categories: public can read, only authenticated admin can write
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Promos: public can read, only authenticated admin can write
    match /promos/{promoId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Testimonials: public can read, only authenticated admin can write
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Business Settings & Opening Hours: public can read, only authenticated admin can write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Users collection for admin profile
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
